# ── 环境标识（12-factor）──
# dev = 本地开发（仅告警缺失项）；prod = 生产（关键配置缺失直接拒绝启动）
# 生产必须由部署平台注入 APP_ENV=prod，本地开发在 .env 里写 APP_ENV=dev
APP_ENV=dev

# LLM 接入（OpenAI 兼容协议，可指向任意兼容服务：火山方舟 / DeepSeek / OpenAI / Ollama…）
# ⚠️ 付费资源，必须填你自己的配置；缺失时服务拒绝启动（不提供任何兜底 key）
# 例：火山方舟 Agent Plan → LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
#    DeepSeek 开放平台 → LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# RAG 服务
RAG_BASE_URL=http://localhost:8080
# 服务间鉴权（与 RAG 侧 server.api_key 保持一致；为空 = RAG 未启用鉴权）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=

# Agent 数据库（Postgres 独立库，多用户 + 会话持久化）
# 先按 migrations/001_init.sql 建库建表；用户名/密码与你的 PG 一致
# ⚠️ 生产必须显式配置，不要用此默认值（校验会拦截本地默认值）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paper_rag_agent

# JWT 认证（阶段 B1 使用）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 必配：空密钥 = 任何人可伪造登录 token
JWT_SECRET=
# access token 有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080
